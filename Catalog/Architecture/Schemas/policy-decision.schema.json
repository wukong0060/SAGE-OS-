{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sageos:schema:architecture:policy-decision:1.0.0",
  "title": "SAGE Policy Decision",
  "description": "Auditable policy-engine result for a specific operation request. UI state is never a substitute for this decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "operationId",
    "decision",
    "riskTier",
    "policyVersion",
    "evaluatedAt",
    "reasons",
    "approval"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "decisionId": {
      "type": "string",
      "format": "uuid"
    },
    "operationId": {
      "type": "string",
      "format": "uuid"
    },
    "decision": {
      "enum": [
        "allow",
        "deny",
        "require_approval"
      ]
    },
    "riskTier": {
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "capabilitySnapshotId"
      ],
      "properties": {
        "result": {
          "enum": [
            "compatible",
            "incompatible",
            "unknown"
          ]
        },
        "capabilitySnapshotId": {
          "type": "string",
          "maxLength": 256
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9_.-]{2,80}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "granted"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "granted": {
          "type": "boolean"
        },
        "actorId": {
          "type": "string",
          "maxLength": 256
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        },
        "approvedScopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policyInputs": {
      "type": "object"
    },
    "policyTraceId": {
      "type": "string",
      "maxLength": 256
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "require_approval"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "required": {
                "const": true
              },
              "granted": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "deny"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "granted": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
