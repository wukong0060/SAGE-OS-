{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sageos:schema:architecture:evidence-record:1.0.0",
  "title": "SAGE Evidence Record",
  "description": "Provenance-aware record for diagnostic findings, measurements, benchmarks and operation evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "recordType",
    "claimType",
    "observedAt",
    "source",
    "provenance",
    "privacyClass",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "evidenceId": {
      "type": "string",
      "format": "uuid"
    },
    "featureId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"
    },
    "operationId": {
      "type": "string",
      "format": "uuid"
    },
    "recordType": {
      "enum": [
        "finding",
        "measurement",
        "benchmark",
        "diagnostic",
        "log_reference",
        "verification"
      ]
    },
    "claimType": {
      "enum": [
        "observed",
        "inferred",
        "recommendation"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "windows_api",
            "performance_counter",
            "powershell",
            "native_provider",
            "user_input",
            "external_provider",
            "derived"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captureMethod",
        "sourceVersion"
      ],
      "properties": {
        "captureMethod": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceVersion": {
          "type": "string",
          "maxLength": 128
        },
        "deviceContextId": {
          "type": "string",
          "maxLength": 256
        },
        "osBuild": {
          "type": "integer",
          "minimum": 7600
        },
        "driverVersions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 128
          }
        },
        "sampleWindowMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "unit": {
      "type": "string",
      "maxLength": 64
    },
    "privacyClass": {
      "enum": [
        "none",
        "user_data",
        "sensitive_redacted",
        "sensitive_not_exportable"
      ]
    },
    "payload": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "relatedEvidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claimType": {
            "const": "observed"
          }
        },
        "required": [
          "claimType"
        ]
      },
      "then": {
        "required": [
          "confidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "benchmark"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "required": [
              "captureMethod",
              "sourceVersion",
              "sampleWindowMs",
              "deviceContextId"
            ]
          }
        }
      }
    }
  ]
}
