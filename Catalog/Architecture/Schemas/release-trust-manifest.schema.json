{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sageos.dev/schemas/architecture/release-trust-manifest-1.0.0.json",
  "title": "SAGE Release Trust Manifest",
  "description": "Release metadata used to bind SAGE artifacts to source, signer, dependencies and published hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "product",
    "version",
    "channel",
    "createdAt",
    "source",
    "artifacts",
    "signer",
    "signature"
  ],
  "properties": {
    "manifestVersion": {
      "const": "1.0.0"
    },
    "product": {
      "const": "SAGE OS"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\\\.[0-9]+\\\\.[0-9]+([+-][A-Za-z0-9.-]+)?$"
    },
    "channel": {
      "enum": [
        "stable",
        "preview",
        "nightly"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40,64}$"
        },
        "tag": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "sha256",
          "sizeBytes",
          "architecture",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1
          },
          "architecture": {
            "enum": [
              "x64",
              "arm64",
              "x86",
              "any"
            ]
          },
          "kind": {
            "enum": [
              "control_center",
              "legacy_companion",
              "ame_apbx",
              "catalog",
              "documentation",
              "support_tool"
            ]
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "license"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "version": {
            "type": "string",
            "maxLength": 128
          },
          "license": {
            "type": "string",
            "maxLength": 128
          },
          "source": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "sbomReference": {
      "type": "string",
      "maxLength": 1024
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "algorithm",
        "certificateFingerprint"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "algorithm": {
          "enum": [
            "Authenticode",
            "Ed25519",
            "ECDSA-P256",
            "RSA-PSS-SHA256"
          ]
        },
        "certificateFingerprint": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40,128}$"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "encoding",
        "value"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "Authenticode",
            "Ed25519",
            "ECDSA-P256",
            "RSA-PSS-SHA256"
          ]
        },
        "encoding": {
          "enum": [
            "base64",
            "detached-file"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      }
    }
  }
}
