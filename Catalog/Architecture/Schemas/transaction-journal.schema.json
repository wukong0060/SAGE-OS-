{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sageos.dev/schemas/architecture/transaction-journal-1.0.0.json",
  "title": "SAGE Transaction Journal",
  "description": "Durable transaction record for mutating SAGE operations and their verification or compensation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "transactionId",
    "operationId",
    "featureId",
    "state",
    "createdAt",
    "updatedAt",
    "steps",
    "recovery"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "transactionId": {
      "type": "string",
      "format": "uuid"
    },
    "operationId": {
      "type": "string",
      "format": "uuid"
    },
    "featureId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"
    },
    "state": {
      "enum": [
        "prepared",
        "running",
        "verifying",
        "committed",
        "failed",
        "rollback_required",
        "rolling_back",
        "rolled_back",
        "recovery_incomplete",
        "cancelled"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "reference"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "none_read_only",
            "user_state_snapshot",
            "transaction_backup",
            "domain_compensation"
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "integrityHash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stepId",
          "name",
          "state"
        ],
        "properties": {
          "stepId": {
            "type": "string",
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "state": {
            "enum": [
              "pending",
              "prepared",
              "running",
              "succeeded",
              "failed",
              "compensation_required",
              "compensating",
              "compensated",
              "skipped"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "resultCode": {
            "type": "string",
            "maxLength": 128
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256
            }
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "state"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "not_required",
            "available",
            "in_progress",
            "verified",
            "failed",
            "incomplete"
          ]
        },
        "attemptCount": {
          "type": "integer",
          "minimum": 0
        },
        "lastAttemptAt": {
          "type": "string",
          "format": "date-time"
        },
        "details": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 256
      }
    },
    "lastError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
